<Window x:Class="ClaudeUsageTracker.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Log in to Claude"
        Height="720" Width="480"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sign in to claude.ai below. This window will close automatically once you're logged in."
                   TextWrapping="Wrap" Margin="10,8" FontSize="12" Foreground="#555555"/>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1" Source="https://claude.ai/login"/>
    </Grid>
</Window>
