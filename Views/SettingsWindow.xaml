<Window x:Class="ClaudeUsageTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage Tracker - Settings"
        Height="560" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource SolidWindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28,26,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ACCOUNT" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,10"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,26">
            <Button x:Name="LoginButton" Content="Log in with claude.ai" DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButtonStyle}" Click="LoginButton_Click"/>
            <TextBlock x:Name="LoginStatusText" Text="Checking login status..." VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="ORGANIZATION" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,10"/>
        <DockPanel Grid.Row="3" Margin="0,0,0,26">
            <Button x:Name="RefreshOrgsButton" Content="Refresh" DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButtonStyle}" Click="RefreshOrgsButton_Click"/>
            <ComboBox x:Name="OrganizationCombo" Margin="0,0,10,0" Padding="10,6" DisplayMemberPath="Name"
                      Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource BorderBrush2}"/>
        </DockPanel>

        <TextBlock Grid.Row="4" Text="APPEARANCE" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,26">
            <RadioButton x:Name="SolidStyleRadio" Content="Solid" GroupName="Style"
                         Style="{StaticResource ModernRadioButtonStyle}" Margin="0,0,28,0"/>
            <RadioButton x:Name="ClearStyleRadio" Content="Clear (see-through)" GroupName="Style"
                         Style="{StaticResource ModernRadioButtonStyle}"/>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="REFRESH INTERVAL (SECONDS, WHILE ACTIVE)" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,26">
            <Slider x:Name="IntervalSlider" Width="280" Minimum="30" Maximum="300" TickFrequency="30"
                    IsSnapToTickEnabled="True" ValueChanged="IntervalSlider_ValueChanged"
                    Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="IntervalValueText" VerticalAlignment="Center" Margin="12,0,0,0" Width="40"
                       Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Margin="0,0,0,10">
            <CheckBox x:Name="AutoStartCheck" Content="Start automatically when Windows starts"
                      Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,14"/>
            <CheckBox x:Name="NotifyCheck" Content="Notify me when usage crosses 80% / 95%"
                      Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,14"/>
        </StackPanel>

        <TextBlock x:Name="StatusMessage" Grid.Row="9" Foreground="{StaticResource AccentBrush}"
                   TextWrapping="Wrap" FontSize="12" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                    Padding="26,8" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
